// Cloudflare Worker deployment of the iCloud Mail connector. See docs/WORKER.md.
// Personal values (addresses, passwords, signatures, owner password) are Worker
// secrets set by scripts/setup-worker.mjs, never committed here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icloud-mail",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  // node:net/node:tls for IMAP and SMTP; strictly public fetches for CIMD documents.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Kept in step with package.json by scripts/sync-version.mjs.
  "define": { "CONNECTOR_VERSION": "\"2.0.0\"" },
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Files uploaded for attachments (create_attachment_upload). setup-worker.mjs
  // creates the bucket and a rule that deletes leftovers after a day.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "icloud-mail-uploads" }],
  // Run next to iCloud's IMAP servers: opening a mailbox takes about ten
  // sequential round trips, which cost seconds from a distant data center.
  "placement": { "host": "imap.mail.me.com:993" },
  // Serves MCP and keeps the IMAP connection open between tool calls.
  "durable_objects": { "bindings": [{ "name": "MAIL_SESSION", "class_name": "MailSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailSession"] }],
  "vars": {
    "APPLE_MAIL_MCP_IMAP_HOST": "imap.mail.me.com",
    "APPLE_MAIL_MCP_IMAP_PORT": "993",
    "APPLE_MAIL_MCP_SMTP_HOST": "smtp.mail.me.com",
    "APPLE_MAIL_MCP_SMTP_PORT": "587",
    "APPLE_MAIL_MCP_SMTP_SECURE": "false"
  },
  "observability": { "enabled": true }
}
