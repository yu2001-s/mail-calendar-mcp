{
  "name": "mail-calendar-mcp",
  "version": "1.6.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "description": "Mail & Calendar MCP connector on Cloudflare Workers: direct iCloud IMAP/SMTP with threaded replies and saved signatures, plus Gmail and Google Calendar for many accounts",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');const ua=process.env.npm_config_user_agent||'';if(fs.existsSync('.git')&&!ua.startsWith('pnpm')){console.error('\\nThis repo uses pnpm. npm/yarn resolve dependencies off-lockfile.\\n\\n  corepack enable && pnpm install --frozen-lockfile\\n');process.exit(1)}\"",
    "build": "tsc --noEmit",
    "deploy:worker": "node scripts/setup-worker.mjs",
    "test:worker": "node --test test/worker-oauth.test.mjs",
    "dev": "tsc --watch --noEmit",
    "test": "vitest run",
    "test:imap": "vitest run --config vitest.imap.config.ts",
    "test:all": "pnpm test && pnpm test:imap",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/sync-version.mjs && git add wrangler.jsonc",
    "prepare": "husky"
  },
  "keywords": [
    "icloud",
    "email",
    "imap",
    "smtp",
    "gmail",
    "google-calendar",
    "mcp",
    "claude",
    "codex",
    "macos"
  ],
  "author": "Poieti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yu2001-s/mail-calendar-mcp.git"
  },
  "homepage": "https://github.com/yu2001-s/mail-calendar-mcp#readme",
  "bugs": {
    "url": "https://github.com/yu2001-s/mail-calendar-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "imapflow": "^1.4.1",
    "nodemailer": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.145.0"
  },
  "volta": {
    "node": "24.17.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "postcss": "^8.5.15"
  }
}
